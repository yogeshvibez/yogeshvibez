<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- The app intentionally rejects cleartext HTTP. Cloudflare supplies HTTPS. -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
